# Copy to .env and fill in real values. Do not commit secrets.

# ciyuan-market provider configuration
AI_PROVIDER_KIND=ciyuan-market
AI_PROVIDER_BASE_URL=https://api.ciyuan-market.com/api/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_LLM_API_KEY=
PUBLIC_ASSET_BASE_URL=


# SMTP configuration for password-reset emails.
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH_METHOD=PLAIN
SMTP_TLS=false
SMTP_LOCAL_NAME=
SMTP_SENDER_NAME=電商寶
SMTP_SENDER_ADDRESS=noreply@example.com

# Generated provider files are retained when not referenced by cloud_works.
GENERATED_RETENTION_DAYS=30
